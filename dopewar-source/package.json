{
  "name": "drug-wars-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/economy.test.mjs",
    "docker:build": "docker build -t dope-war .",
    "docker:run": "docker run -d -p 8080:80 --name dope-war-game dope-war",
    "docker:stop": "docker stop dope-war-game && docker rm dope-war-game",
    "docker:compose": "docker compose up --build",
    "build:site": "npm test && npm run build -- --base=/dopewar/ --outDir ../dopewar"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
